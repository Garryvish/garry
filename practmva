#apriori
data(Groceries)
data
summary(Groceries)
Groceries@itemInfo[1:20,]
rules<-apriori(Groceries, parameter=list(supp=0.01, conf=0.2))
inspect(rules[1:10,])
install.packages("RColorBrewer")
library(RColorBrewer)
arules::itemFrequencyPlot(Groceries, topN=20,col=brewer.pal(8,"Pastel2"), main="Item frequency plot", type="relative", ylab="Item of fequency")


